{
  "Version": "2012-10-17",
  "Comment": "Attach to the app IAM user/role (Streamlit app, local dev). Replace YOUR_BUCKET_NAME.",
  "Statement": [
    {
      "Sid": "DocumentAgentS3Access",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::YOUR_BUCKET_NAME/*"
    },
    {
      "Sid": "DocumentAgentS3ListBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::YOUR_BUCKET_NAME"
    }
  ]
}
