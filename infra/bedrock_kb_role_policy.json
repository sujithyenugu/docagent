{
  "Version": "2012-10-17",
  "Comment": "Attach to the Bedrock KB service role (AmazonBedrockExecutionRoleForKnowledgeBase_*).",
  "Statement": [
    {
      "Sid": "ReadOutputDocuments",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::YOUR_BUCKET_NAME",
        "arn:aws:s3:::YOUR_BUCKET_NAME/*/output/*"
      ]
    },
    {
      "Sid": "OpenSearchServerlessAccess",
      "Effect": "Allow",
      "Action": ["aoss:APIAccessAll"],
      "Resource": "arn:aws:aoss:YOUR_REGION:YOUR_ACCOUNT_ID:collection/*"
    }
  ]
}
